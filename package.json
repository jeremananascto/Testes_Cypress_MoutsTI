{
  "name": "cypress-serverest-tests",
  "version": "1.0.0",
  "description": "Suite de testes automatizados (E2E de frontend e API) para a aplicação ServeRest, utilizando Cypress e JavaScript.",
  "private": true,
  "scripts": {
    "cy:open": "cypress open",
    "test": "cypress run",
    "test:frontend": "cypress run --spec \"cypress/e2e/frontend/**/*.cy.js\"",
    "test:api": "cypress run --spec \"cypress/e2e/api/**/*.cy.js\"",
    "test:headless": "cypress run --browser chrome --headless"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "cypress": "^13.15.0"
  },
  "keywords": [
    "cypress",
    "e2e",
    "api-testing",
    "serverest",
    "qa-automation"
  ],
  "license": "MIT"
}
